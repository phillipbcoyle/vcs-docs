{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Virtual Controller Supply",
  "colors": {
    "primary": "#53c0da",
    "light": "#e8dcb9",
    "dark": "#384959"
  },
  "favicon": "/images/icon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Welcome",
        "icon": "house",
        "groups": [
          {
            "group": "Get Started",
            "icon": "star-shooting",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Feedback & Support",
            "icon": "lightbulb",
            "pages": [
              "troubleshooting",
              "feedback",
              "support"
            ]
          }
        ]
      },
      {
        "tab": "STARS Keyboard",
        "icon": "radar",
        "groups": [
          {
            "group": "STARS Keyboard",
            "icon": "radar",
            "pages": [
              "stars/quickstart",
              "stars/keymap"
            ]
          }
        ]
      },
      {
        "tab": "ERAM Keyboard",
        "icon": "keyboard",
        "groups": [
          {
            "group": "ERAM Keyboard",
            "icon": "keyboard",
            "pages": [
              "eram/quickstart",
              "eram/keymap",
              "eram/ksd"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/stars/quickstart"
    },
    {
      "source": "/keymap",
      "destination": "/stars/keymap"
    }
  ],
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://virtualcontrollersupply.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Main Website",
      "href": "https://virtualcontrollersupply.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/FlightSimExpo",
      "facebook": "https://www.facebook.com/FlightSimExpo",
      "instagram": "https://www.instagram.com/FlightSimExpo",
      "youtube": "https://www.youtube.com/c/FlightSimExp"
    }
  },
  "description": "Installation instructions, troubleshooting steps, and other assistance for Virtual Controller Supply products.",
  "appearance": {
    "strict": true
  },
  "background": {
    "decoration": "grid"
  }
}
